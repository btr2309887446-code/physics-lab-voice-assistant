+# 工具名 → 展示给学生的人话（不是给开发看的）。可在 data/.config.yaml 的
+# tool_status_text 里按键覆盖，键名 _default 是所有工具的兜底。
+DEFAULT_TOOL_STATUS_TEXT = {
+    "search_from_ragflow": "让我查一下资料…",
+    "get_time": "稍等，我看下时间…",
+    "get_weather": "我看看天气…",
+    "get_news_from_chinanews": "我翻一下新闻…",
+    "get_news_from_newsnow": "我翻一下新闻…",
+    "play_music": "我去找首歌…",
+    "handle_exit_intent": "好，那我先退下…",
+    "_default": "让我想想…",
+}
+
+
+def resolve_tool_status_text(conn, name):
+    """把工具名翻译成人话。优先级：config 精确 → 内置精确 → config 兜底 → 内置兜底"""
+    override = {}
+    if conn is not None:
+        override = conn.config.get("tool_status_text") or {}
+    if name in override:
+        return override[name]
+    if name in DEFAULT_TOOL_STATUS_TEXT:
+        return DEFAULT_TOOL_STATUS_TEXT[name]
+    return override.get("_default") or DEFAULT_TOOL_STATUS_TEXT["_default"]
+
+
+async def send_tool_status_message(conn: "ConnectionHandler", name, state="start", text=None):
+    """发送工具调用状态（独立消息类型，不进字幕）
+
+    以前这里发的是 {"type": "stt", "text": "% search_from_ragflow"}，
+    设备端会把 stt 当成用户说的话刷到字幕条上，于是学生看到
+    “% search_from_ragflow” 这种后台信息。
+
+    现在改为独立的 tool 消息类型，并带一句人话（text）：
+    不认识该类型的设备会安全忽略；认识它的就在状态栏显示
+    “让我查一下资料…” 这种提示，既不污染字幕也不像机器。
+    """
+    if text is None:
+        text = resolve_tool_status_text(conn, name)
+    message = {
+        "type": "tool",
+        "state": state,
+        "name": name,
+        "text": text,
+        "session_id": conn.session_id,
+    }
+    await conn.websocket.send(json.dumps(message, ensure_ascii=False))
