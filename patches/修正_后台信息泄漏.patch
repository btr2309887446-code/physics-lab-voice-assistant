+        "tool"  —— 已确认是工具调用文本，不能播报
+        "plain" —— 已确认是正常回答，可以放行
+        "wait"  —— 还看不出来（标记可能被拆成多个 chunk），先压着别播
+    """
+    stripped = pending.lstrip()
+    if stripped.startswith(marker):
+        return "tool"
+    # 已收到的内容不是标记的前缀 → 一定是正常回答
+    if not marker.startswith(stripped[: len(marker)]):
+        return "plain"
+    # 压着的字数足够多了，不再等（避免极端情况一直不播）
+    if len(pending) >= holdback_chars:
+        return "plain"
+    return "wait"
+
